{
  // =====================================================================
  // Deployed from the Cloudflare dashboard — no terminal required.
  //
  // Ask Claude to fill this in (it runs `npm run configure`), or edit by
  // hand. Find whatever is still unset:
  //   grep -in "change.me\|0000000" wrangler.jsonc
  //
  // Full walkthrough: docs/deploy.md
  // =====================================================================
  "$schema": "node_modules/wrangler/config-schema.json",

  // CHANGE_ME — the Worker script name. This is the identity Cloudflare
  // stores secrets, routes and deployments against, so renaming it later
  // creates a *new* worker and orphans the old one's secrets.
  "name": "alex-website",

  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // This app server-renders every page, so unmatched paths are handled
    // by the worker's own notFound, not by an SPA shell. "none" keeps the
    // asset layer from swallowing 404s that should reach your router.
    "not_found_handling": "none",
  },

  "observability": {
    "enabled": true,
  },

  "dev": {
    "port": 3000,
    "local_protocol": "http",
  },

  // ---------------------------------------------------------------------
  // Everything below is production. Cloudflare builds and deploys this on
  // every push once the repo is connected under Settings -> Builds.
  //
  // Adding a staging environment later means adding an "env": { "staging":
  // {...} } block — but named environments INHERIT NOTHING, so every binding
  // and var must be repeated inside it, and it deploys a SEPARATE worker with
  // its own secrets. See the appendix in docs/deploy.md.
  // ---------------------------------------------------------------------

  // CHANGE_ME — delete this block to publish on <name>.<subdomain>.workers.dev
  // instead. `zone_name` is only required when the record is ambiguous;
  // a custom_domain on a zone in the same account resolves without it.
  "routes": [
    {
      "pattern": "alex.stanbrook.me",
      "custom_domain": true,
    },
  ],

  // CHANGE_ME — Dashboard: Storage & Databases -> D1 -> Create.
  //             The Database ID is on the database's overview page.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alex-website-db",
      "database_id": "1c77d1e3-834f-487a-8369-2cbc4adee9cb",
      "migrations_dir": "drizzle",
    },
  ],

  // CHANGE_ME — Dashboard: Storage & Databases -> KV -> Create Instance.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "66ab5bda6f324ed7b0a8f7b750cddac4",
    },
  ],

  // No R2: version 1 stores no files. Notes are text and resources are links.
  // Add an "r2_buckets" block (and `R2` in worker/types.ts) if uploads arrive.

  // Edge rate limiting. `namespace_id` is an arbitrary number you pick per
  // limiter within this worker — it is NOT a resource to provision, so
  // nothing here needs changing. Used by the auth API to throttle login
  // attempts by IP before they reach the database.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],

  "vars": {
    "ENVIRONMENT": "production",

    // --- BRANDING ---
    // CHANGE_ME — how the site names itself in the title, nav and footer.
    "APP_NAME": "Study Hub",
    "APP_TAGLINE": "A cosy little corner for uni: plans, notes, flashcards and grades.",
    "APP_LOCALE": "en-AU",
    "APP_CURRENCY": "AUD",
    // IANA zone. Decides what "today" means on the Today screen and planner —
    // in UTC, a Perth morning is still yesterday until 8am.
    "APP_TIMEZONE": "Australia/Perth",

    // --- CORE AUTH ---
    // Enabled methods: passkey, password, pin, totp, email, sms
    "AUTH_METHODS": "password,passkey,totp",

    // Milliseconds.
    "SESSION_DURATION": "86400000",
    "SESSION_RENEWAL_THRESHOLD": "3600000",
    "MAX_SESSIONS_PER_USER": "5",

    // SECONDS — not milliseconds. This sets the JWT `exp` claim and the
    // cookie Max-Age directly. Pasting a millisecond value here (86400000)
    // yields a ~2.7 YEAR session, not a day. 86400 = 24 hours.
    "JWT_EXPIRY": "86400",

    // --- SECURITY ---
    // JWT_SECRET is deliberately absent: it is a SECRET, not a var. Set it in
    // the dashboard under Settings -> Variables and Secrets, type "Secret".
    // Putting it here commits it to git and leaks it to anyone with repo
    // access. See docs/deploy.md.
    "MAX_FAILED_LOGIN_ATTEMPTS": "5",
    "LOCKOUT_DURATION": "900000",
    "REQUIRE_EMAIL_VERIFICATION": "false",
    "REQUIRE_PHONE_VERIFICATION": "false",
    // Comma-separated allowlist. Empty means open registration.
    // Set this for an invite-only or single-user site.
    "ALLOWED_EMAILS": "",

    // One-owner site. Sign-up accepts only BOOTSTRAP_ADMIN_EMAIL, and only
    // while no account exists; after that /register is gone for good. Needs
    // BOOTSTRAP_ADMIN_EMAIL set, or nobody can ever register.
    "SINGLE_ACCOUNT": "true",

    // First-run admin, so you never need a terminal to get one. Register
    // normally with this exact email and that account becomes an admin — but
    // ONLY while no admin exists yet, so it disarms itself the moment it
    // works. Safe to leave set; tidier to clear afterwards.
    "BOOTSTRAP_ADMIN_EMAIL": "alex@stanbrook.me",

    // --- ROLES & PERMISSIONS ---
    // CHANGE_ME — model your own resources here. Convention:
    //   resource.action      → the action on rows the user owns
    //   resource.action.any  → the action on anyone's rows
    //   "*"                  → expands to all of PERMISSIONS_AVAILABLE
    // Keep the resource names in sync with the `Resource` type in
    // worker/services/access.service.ts.
    "ROLES_AVAILABLE": "user,admin",
    "ROLES_DEFAULT": "user",
    // Roles that cannot be self-assigned at registration. Get your first
    // admin with BOOTSTRAP_ADMIN_EMAIL below — no terminal needed.
    "ROLES_RESTRICTED": "admin",
    "PERMISSIONS_AVAILABLE": "semesters.read,semesters.create,semesters.update,semesters.delete,subjects.read,subjects.create,subjects.update,subjects.delete,assignments.read,assignments.create,assignments.update,assignments.delete,exams.read,exams.create,exams.update,exams.delete,notes.read,notes.create,notes.update,notes.delete,resources.read,resources.create,resources.update,resources.delete,sessions.read,sessions.create,sessions.update,sessions.delete,flashcards.read,flashcards.create,flashcards.update,flashcards.delete,grades.read,grades.create,grades.update,grades.delete",
    "ROLES_INHERENT": "admin:*",

    // --- PASSKEY / WEBAUTHN ---
    // CHANGE_ME — these MUST match the deployed domain or passkeys fail
    // with no useful error. RP_ID is the bare hostname (no scheme, no
    // port); ORIGIN is the full origin users load the site from.
    "RP_NAME": "Study Hub",
    "RP_ID": "alex.stanbrook.me",
    "ORIGIN": "https://alex.stanbrook.me",

    // --- PASSWORD CONFIG ---
    // These are enforced on registration, password change and reset. They used
    // to be read into config and checked nowhere, so the values here made no
    // difference to anything.
    //
    // Length over composition, per NIST SP 800-63B. Requiring an uppercase, a
    // digit and a symbol adds little entropy and reliably produces
    // "Password1!", while pushing people towards reuse and sticky notes; a
    // longer minimum is worth more than all four rules together. Set any of
    // them to "true" if a compliance checklist demands it.
    "PASSWORD_MIN_LENGTH": "12",
    "PASSWORD_REQUIRE_UPPERCASE": "false",
    "PASSWORD_REQUIRE_LOWERCASE": "false",
    "PASSWORD_REQUIRE_NUMBERS": "false",
    "PASSWORD_REQUIRE_SPECIAL": "false",

    // PBKDF2 rounds for new password hashes. Raising this is safe and
    // self-applying: the cost is stored with each hash, and accounts are
    // re-hashed as their owners next sign in. See worker/lib/crypto.ts.
    "PASSWORD_HASH_ITERATIONS": "210000",

    // --- PIN CONFIG ---
    "PIN_LENGTH": "6",
    "PIN_NUMBERS_ONLY": "true",

    // --- TOTP CONFIG ---
    // TOTP_ISSUER is the name shown in the user's authenticator app.
    "TOTP_ISSUER": "Study Hub",
    "TOTP_ALGORITHM": "SHA1",
    "TOTP_DIGITS": "6",
    "TOTP_PERIOD": "30",
  },
}
