{
  "name": "frug-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "// build": "Runs in Cloudflare's build container. `wrangler types` first because worker-configuration.d.ts is generated, not committed, and tsc needs it.",
    "build": "wrangler types && npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build --mode client",
    "build:server": "vite build",
    "typecheck": "tsc -b",
    "// deploy": "The Deploy command to paste into the Cloudflare dashboard. Migrations run before the new code goes live.",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "gen": "drizzle-kit generate && wrangler types",
    "migrate:local": "npm run gen && wrangler d1 migrations apply DB",
    "migrate:remote": "npm run gen && wrangler d1 migrations apply DB --remote",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-admin:local": "tsx scripts/create-admin.ts --local",
    "create-admin:remote": "tsx scripts/create-admin.ts --remote",
    "configure": "tsx scripts/configure.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@hono/vite-dev-server": "^0.23.0",
    "@hono/zod-validator": "^0.9.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@simplewebauthn/types": "^12.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.9.0",
    "htmx.org": "^2.0.8",
    "lit": "^3.3.1",
    "lucide": "^0.560.0",
    "otpauth": "^9.4.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.11",
    "wrangler": "^4.61.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@hono/vite-build": "^1.8.0",
    "@types/node": "^24.10.2",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.1",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.2.7",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "core-js",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
